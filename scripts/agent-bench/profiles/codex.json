{
  "name": "codex",
  "command": "codex",
  "real_binary_names": ["codex"],
  "version_args": ["--version"],
  "launch_args_by_scenario": {
    "smoke": [
      "exec",
      "--sandbox",
      "workspace-write",
      "Run this exact shell command: printf ZENTTY_AGENT_BENCH_OK"
    ],
    "session_capture": [
      "exec",
      "--sandbox",
      "workspace-write",
      "Run this exact shell command: printf ZENTTY_AGENT_BENCH_OK"
    ],
    "tasks": [
      "--model",
      "gpt-6-luna",
      "--config",
      "model_reasoning_effort=\"low\"",
      "--config",
      "tools.update_plan={enabled=true}",
      "--sandbox",
      "workspace-write",
      "--ask-for-approval",
      "on-request",
      "Use your task list tool (update_plan) to create a task list with these exact three tasks: Review directory, Identify main language, Suggest one improvement. Mark Review directory completed. Mark Identify main language in progress. Leave Suggest one improvement pending. Then run this exact shell command: printf ZENTTY_AGENT_BENCH_TASKS_OK"
    ],
    "restart": [
      "exec",
      "--sandbox",
      "workspace-write",
      "Run this exact shell command: printf ZENTTY_AGENT_BENCH_OK"
    ],
    "tui_restart": [
      "--no-alt-screen"
    ],
    "approval": [
      "--model",
      "gpt-6-luna",
      "--config",
      "model_reasoning_effort=\"low\"",
      "--config",
      "approvals_reviewer=\"user\"",
      "--sandbox",
      "read-only",
      "--ask-for-approval",
      "on-request",
      "For an integration hook regression test, run this exact shell command with escalated sandbox permissions, so I am asked to approve it first: touch ZENTTY_AGENT_BENCH_APPROVAL_OK"
    ],
    "auto_approval": [
      "--model",
      "gpt-6-luna",
      "--config",
      "model_reasoning_effort=\"low\"",
      "--ask-for-approval",
      "on-request",
      "exec",
      "--sandbox",
      "workspace-write",
      "Run this exact shell command: printf ZENTTY_AGENT_BENCH_AUTO_APPROVAL_OK"
    ],
    "question": [
      "--model",
      "gpt-6-luna",
      "--config",
      "model_reasoning_effort=\"low\"",
      "Ask me one short random question using the askuserquestion tool. Do not answer it yourself."
    ],
    "question_interrupt": [
      "--model",
      "gpt-6-luna",
      "--config",
      "model_reasoning_effort=\"low\"",
      "Ask me one short random question using the askuserquestion tool. Do not answer it yourself."
    ],
    "manual_compact": [
      "--no-alt-screen"
    ],
    "restore_launch": [
      "resume",
      "session-codex"
    ],
    "subagents": [
      "exec",
      "--sandbox",
      "workspace-write",
      "For an integration hook regression test: use the spawn_agent tool once to start a worker subagent whose task is to run this exact shell command and report its output: printf ZENTTY_AGENT_BENCH_SUBAGENT_OK. Wait for that subagent with wait_agent, then reply with exactly DONE."
    ]
  },
  "expectations": {
    "smoke": {
      "required_events": ["session-start", "prompt-submit", "pre-tool-use", "post-tool-use", "stop"]
    },
    "session_capture": {
      "required_events": ["session-start", "prompt-submit", "pre-tool-use", "post-tool-use", "stop"],
      "session_identity": {
        "session_id_pattern": "codex",
        "tracked_pid": true
      }
    },
    "tasks": {
      "required_events": ["session-start", "prompt-submit", "post-tool-use", "stop"],
      "expected_task_progress": {"done": 1, "total": 3},
      "expected_task_items": [
        {"title": "Review directory", "status": "completed"},
        {"title": "Identify main language", "status": "in_progress"},
        {"title": "Suggest one improvement", "status": "pending"}
      ]
    },
    "restart": {
      "required_events": [
        "session-start",
        "prompt-submit",
        "pre-tool-use",
        "post-tool-use",
        "stop",
        "session-start",
        "prompt-submit",
        "pre-tool-use",
        "post-tool-use",
        "stop"
      ]
    },
    "tui_restart": {
      "required_events": [],
      "required_terminal_phases": ["idle", "starting", "idle", "starting"]
    },
    "approval": {
      "required_events": ["session-start", "prompt-submit", "permission-request", "post-tool-use", "stop"]
    },
    "auto_approval": {
      "required_events": ["session-start", "prompt-submit", "pre-tool-use", "post-tool-use", "stop"],
      "forbidden_events": ["permission-request"],
      "forbidden_terminal_phases": ["needs-input"]
    },
    "question": {
      "required_events": ["session-start", "prompt-submit"]
    },
    "question_interrupt": {
      "required_events": ["session-start", "prompt-submit"]
    },
    "manual_compact": {
      "required_events": ["pre-compact", "post-compact"]
    },
    "restore_launch": {
      "required_events": [],
      "required_bootstrap_arguments": [["resume", "session-codex"]]
    },
    "subagents": {
      "required_events": ["session-start", "prompt-submit", "subagent-start", "subagent-stop", "stop"],
      "subagent_payload_required": true
    }
  },
  "input_by_scenario": {
    "approval": [
      {
        "match": "trust",
        "delay": 1,
        "text": "1\r",
        "label": "trust-workspace"
      },
      {
        "match": "Would you like to run the following command",
        "delay": 1,
        "text": "y\r",
        "label": "approve-command"
      }
    ],
    "tasks": [
      {
        "match": "trust",
        "delay": 1,
        "text": "1\r",
        "label": "trust-workspace"
      },
      {
        "match": "Would you like to run the following command",
        "text": "y\r",
        "label": "approve-command"
      },
      {
        "match": "(?m)^[^\\w\\n]*ZENTTY_AGENT_BENCH_TASKS_OK\\s*$",
        "after": 15,
        "text": "/quit\r",
        "label": "quit"
      }
    ],
    "question": [
      {
        "match": "trust",
        "delay": 1,
        "text": "1\r",
        "label": "trust-workspace"
      }
    ],
    "question_interrupt": [
      {
        "match": "trust",
        "delay": 1,
        "text": "1\r",
        "label": "trust-workspace"
      },
      {
        "match": "Action Required",
        "text": "\u0003",
        "label": "ctrl-c"
      }
    ],
    "tui_restart": [
      {
        "match": "trust",
        "delay": 1,
        "text": "1\r",
        "label": "trust-workspace"
      },
      {
        "match": "Context 100% left",
        "text": "/quit\n",
        "label": "quit"
      }
    ],
    "manual_compact": [
      {
        "match": "trust",
        "delay": 1,
        "text": "1\r",
        "label": "trust-workspace"
      },
      {
        "match": "Ready \\| codex-manual_compact",
        "text": "/compact\r",
        "label": "manual-compact"
      }
    ]
  },
  "repeat_by_scenario": {
    "restart": 2,
    "tui_restart": 2
  },
  "skip_patterns": ["login", "auth", "not authenticated", "api key", "sign in", "no such option"]
}
