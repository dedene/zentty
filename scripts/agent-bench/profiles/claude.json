{
  "name": "claude",
  "command": "claude",
  "real_binary_names": [
    "claude"
  ],
  "version_args": [
    "--version"
  ],
  "launch_args_by_scenario": {
    "background_routing": [
      "--setting-sources",
      "project,local",
      "--bg",
      "Reply with exactly: ZENTTY_AGENT_BENCH_OK"
    ],
    "smoke": [
      "--setting-sources",
      "project,local",
      "--print",
      "--verbose",
      "--output-format",
      "stream-json",
      "--include-hook-events",
      "--max-budget-usd",
      "1.00",
      "Run this exact shell command: printf ZENTTY_AGENT_BENCH_OK"
    ],
    "session_capture": [
      "--setting-sources",
      "project,local",
      "--print",
      "--verbose",
      "--output-format",
      "stream-json",
      "--include-hook-events",
      "--max-budget-usd",
      "1.00",
      "Run this exact shell command: printf ZENTTY_AGENT_BENCH_OK"
    ],
    "approval": [
      "--setting-sources",
      "project,local",
      "--permission-mode",
      "default",
      "--model",
      "haiku",
      "--max-budget-usd",
      "1.00",
      "For an integration hook regression test, create a file named ZENTTY_AGENT_BENCH_APPROVAL_OK in the current directory using the Write tool. Put the text ZENTTY_AGENT_BENCH_APPROVAL_OK in the file."
    ],
    "tasks": [
      "--setting-sources",
      "project,local",
      "--permission-mode",
      "default",
      "--max-budget-usd",
      "1.00",
      "Use your task list tool (TaskCreate/TaskUpdate) to create a task list with these exact three tasks: Review directory, Identify main language, Suggest one improvement. Mark Review directory completed. Mark Identify main language in progress. Leave Suggest one improvement pending. Then run this exact shell command: printf ZENTTY_AGENT_BENCH_TASKS_OK"
    ],
    "manual_compact": [
      "--setting-sources",
      "project,local"
    ],
    "restore_launch": [
      "--resume",
      "237d8c32-2a27-4850-8da8-3a110f13682c"
    ],
    "approval_then_work": [
      "--setting-sources",
      "project,local",
      "--permission-mode",
      "default",
      "--model",
      "haiku",
      "--max-budget-usd",
      "1.00",
      "For an integration hook regression test: 1) create a file named ZENTTY_AGENT_BENCH_APPROVAL_OK in the current directory using the Write tool with the text ZENTTY_AGENT_BENCH_APPROVAL_OK. 2) Then, without asking me anything, read README.md with the Read tool. 3) Then search for the word bench in this directory with the Grep tool. 4) Then reply with exactly DONE."
    ],
    "approval_agent_tool": [
      "--setting-sources",
      "project,local",
      "--permission-mode",
      "default",
      "--model",
      "haiku",
      "--max-budget-usd",
      "1.00",
      "For an integration hook regression test: use the Agent tool exactly once, with subagent_type Explore, to list the files in the current directory. Wait for it to finish, then reply with exactly DONE."
    ],
    "approval_during_subagent": [
      "--setting-sources",
      "project,local",
      "--permission-mode",
      "default",
      "--model",
      "haiku",
      "--max-budget-usd",
      "1.00",
      "For an integration hook regression test: 1) use the Agent tool exactly once, with subagent_type Explore and run_in_background true, and give it this exact task: \"Read README.md with the Read tool, then list the files in the current directory, then reply done.\" 2) As soon as the Agent call returns, create a file named ZENTTY_AGENT_BENCH_APPROVAL_OK in the current directory using the Write tool with the text ZENTTY_AGENT_BENCH_APPROVAL_OK. 3) Then reply with exactly DONE."
    ],
    "approval_overlap_agents": [
      "--setting-sources",
      "project,local",
      "--permission-mode",
      "default",
      "--model",
      "haiku",
      "--max-budget-usd",
      "1.00",
      "For an integration hook regression test: in one single assistant message, issue two Agent tool calls side by side as parallel tool calls, both with subagent_type Explore. The first lists the files in the current directory, the second reads README.md. Wait for both, then reply with exactly DONE."
    ],
    "approval_overlap_worker": [
      "--setting-sources",
      "project,local",
      "--permission-mode",
      "default",
      "--model",
      "haiku",
      "--max-budget-usd",
      "1.00",
      "For an integration hook regression test: 1) use the Agent tool exactly once, with subagent_type general-purpose and run_in_background true, and give it this exact task: \"Run the Bash tool once with the command: touch ZENTTY_AGENT_BENCH_WORKER_OK. Then reply done.\" 2) As soon as the Agent call returns, create a file named ZENTTY_AGENT_BENCH_APPROVAL_OK in the current directory using the Write tool with the text ZENTTY_AGENT_BENCH_APPROVAL_OK. 3) Then reply with exactly DONE."
    ],
    "subagents": [
      "--setting-sources",
      "project,local",
      "--print",
      "--verbose",
      "--output-format",
      "stream-json",
      "--include-hook-events",
      "--max-budget-usd",
      "2.00",
      "For an integration hook regression test: use the Agent tool once, with subagent_type Explore, to list the files in the current directory. Wait for it to finish, then reply with exactly DONE."
    ],
    "subagents_async": [
      "--setting-sources",
      "project,local",
      "--print",
      "--verbose",
      "--output-format",
      "stream-json",
      "--include-hook-events",
      "--max-budget-usd",
      "2.00",
      "For an integration hook regression test: use the Agent tool exactly once, with subagent_type Explore and run_in_background true, to list the files in the current directory. Do not wait for it: as soon as the Agent tool call returns, reply with exactly DONE and end your turn. Later, when the task notification for that agent arrives, reply with exactly DONE again."
    ],
    "subagents_workflow": [
      "--setting-sources",
      "project,local",
      "--print",
      "--verbose",
      "--output-format",
      "stream-json",
      "--include-hook-events",
      "--allowedTools",
      "Workflow,Bash(ls)",
      "--model",
      "haiku",
      "--max-budget-usd",
      "2.00",
      "For an integration hook regression test, use a workflow: run the Workflow tool once with exactly this inline script. export const meta = {name:\"zentty-bench\",description:\"bench\",phases:[{title:\"Verify\"},{title:\"Review\"}]}; await parallel([() => agent(\"Run the Bash tool once with the command: ls. Then reply done.\", {label:\"a\",phase:\"Verify\"}), () => agent(\"Run the Bash tool once with the command: ls. Then reply done.\", {label:\"b\",phase:\"Review\"})]); When it finishes, reply with exactly DONE."
    ],
    "subagents_nested": [
      "--setting-sources",
      "project,local",
      "--print",
      "--verbose",
      "--output-format",
      "stream-json",
      "--include-hook-events",
      "--max-budget-usd",
      "2.00",
      "For an integration hook regression test: use the Agent tool exactly once, with subagent_type general-purpose, and give it this exact task: \"Use the Agent tool exactly once, with subagent_type Explore, to list the files in the current directory. Wait for it to finish, then reply with exactly DONE.\" Wait for the general-purpose agent to finish, then reply with exactly DONE."
    ]
  },
  "expectations": {
    "background_routing": {
      "required_events": [
        "SessionStart",
        "UserPromptSubmit",
        "Stop"
      ],
      "daemon_pane_routing": true
    },
    "smoke": {
      "required_events": [
        "SessionStart",
        "UserPromptSubmit",
        "Stop"
      ]
    },
    "session_capture": {
      "required_events": [
        "SessionStart",
        "UserPromptSubmit",
        "Stop"
      ],
      "session_identity": {
        "session_id_pattern": "uuid",
        "tracked_pid": true
      }
    },
    "approval": {
      "required_events": [
        "SessionStart",
        "UserPromptSubmit",
        "PreToolUse",
        "PermissionRequest",
        "PostToolUse",
        "Stop"
      ],
      "hook_trace": true
    },
    "tasks": {
      "required_events": [
        "SessionStart",
        "UserPromptSubmit",
        "PostToolUse",
        "Stop"
      ],
      "expected_task_progress": {"done": 1, "total": 3},
      "expected_task_items": [
        {"title": "Review directory", "status": "completed"},
        {"title": "Identify main language", "status": "in_progress"},
        {"title": "Suggest one improvement", "status": "pending"}
      ]
    },
    "stop_race": {
      "synthetic": true,
      "fixture": "claude_stop_then_late_notification.jsonl",
      "required_events": [
        "SessionStart",
        "UserPromptSubmit",
        "PreToolUse",
        "Stop",
        "Notification"
      ],
      "post_stop_notification_required": true
    },
    "manual_compact": {
      "required_events": [
        "SessionStart",
        "PreCompact"
      ]
    },
    "restore_launch": {
      "required_events": [],
      "required_bootstrap_arguments": [
        [
          "--resume",
          "237d8c32-2a27-4850-8da8-3a110f13682c"
        ]
      ]
    },
    "approval_then_work": {
      "required_events": [
        "SessionStart",
        "UserPromptSubmit",
        "PreToolUse",
        "PermissionRequest",
        "PostToolUse",
        "Stop"
      ],
      "hook_trace": true
    },
    "approval_agent_tool": {
      "required_events": [
        "SessionStart",
        "UserPromptSubmit",
        "PermissionRequest:Agent",
        "SubagentStart:Explore",
        "SubagentStop:Explore",
        "PostToolUse:Agent",
        "Stop",
        "Stop"
      ],
      "hook_trace": true
    },
    "approval_during_subagent": {
      "required_events": [
        "SessionStart",
        "UserPromptSubmit",
        "SubagentStart:Explore",
        "PermissionRequest:Write",
        "SubagentStop:Explore",
        "PostToolUse:Write",
        "Stop"
      ],
      "hook_trace": true
    },
    "approval_overlap_agents": {
      "required_events": [
        "SessionStart",
        "UserPromptSubmit",
        "PermissionRequest:Agent",
        "PermissionRequest:Agent",
        "SubagentStart:Explore",
        "SubagentStart:Explore",
        "SubagentStop:Explore",
        "SubagentStop:Explore",
        "Stop"
      ],
      "hook_trace": true
    },
    "approval_overlap_worker": {
      "required_events": [
        "SessionStart",
        "UserPromptSubmit",
        "SubagentStart:general-purpose",
        "PermissionRequest:Write",
        "PermissionRequest:Bash",
        "SubagentStop:general-purpose",
        "Stop"
      ],
      "hook_trace": true
    },
    "subagents": {
      "required_events": [
        "SessionStart",
        "UserPromptSubmit",
        "SubagentStart",
        "SubagentStop",
        "Stop"
      ],
      "subagent_payload_required": true
    },
    "subagents_async": {
      "required_events": [
        "SessionStart",
        "UserPromptSubmit",
        "SubagentStart",
        "Stop",
        "SubagentStop"
      ],
      "subagent_payload_required": true,
      "event_order": [
        [
          "Stop",
          "SubagentStop"
        ]
      ]
    },
    "subagents_workflow": {
      "required_events": [
        "SessionStart",
        "UserPromptSubmit",
        "SubagentStart",
        "SubagentStart",
        "SubagentStop",
        "SubagentStop",
        "Stop"
      ],
      "subagent_payload_required": true,
      "workflow_contract_required": true
    },
    "subagents_nested": {
      "required_events": [
        "SessionStart",
        "UserPromptSubmit",
        "SubagentStart",
        "SubagentStart",
        "SubagentStop",
        "SubagentStop",
        "Stop"
      ],
      "subagent_payload_required": true,
      "subagent_nested_required": true
    }
  },
  "environment_by_scenario": {
    "tasks": {
      "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
      "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
    }
  },
  "input_by_scenario": {
    "approval": [
      {
        "match": "Do you want",
        "delay": 2,
        "text": "1\n",
        "label": "approve"
      }
    ],
    "tasks": [
      {
        "match": "Command to approve|Yes, allow|Do you want|Permission|allow",
        "text": "1\n",
        "label": "approve"
      },
      {
        "match": "(?m)^[^\\w\\n]*ZENTTY_AGENT_BENCH_TASKS_OK\\s*$",
        "after": 15,
        "text": "/exit\r",
        "label": "exit"
      }
    ],
    "manual_compact": [
      {
        "match": "for shortcuts|Claude Code",
        "after": 1,
        "text": "/compact\r",
        "label": "manual-compact"
      }
    ],
    "approval_then_work": [
      {
        "match": "Do you want",
        "delay": 8,
        "text": "1\n",
        "label": "approve"
      }
    ],
    "approval_agent_tool": [
      {
        "match": "Do you want",
        "delay": 8,
        "text": "1\n",
        "label": "approve"
      },
      {
        "match": "Do you want",
        "after_previous": true,
        "delay": 8,
        "text": "1\n",
        "label": "approve-repeat-call"
      }
    ],
    "approval_during_subagent": [
      {
        "match": "Do you want",
        "delay": 15,
        "text": "1\n",
        "label": "approve"
      }
    ],
    "approval_overlap_agents": [
      {
        "match": "Do you want",
        "delay": 10,
        "text": "1\n",
        "label": "approve-first"
      },
      {
        "match": "Do you want",
        "after_previous": true,
        "delay": 10,
        "text": "1\n",
        "label": "approve-second"
      }
    ],
    "approval_overlap_worker": [
      {
        "match": "Do you want",
        "delay": 10,
        "text": "1\n",
        "label": "approve-first"
      },
      {
        "match": "Do you want",
        "after_previous": true,
        "delay": 10,
        "text": "1\n",
        "label": "approve-second"
      }
    ]
  },
  "repo_files_by_scenario": {
    "approval_agent_tool": {
      ".claude/settings.local.json": "{\"permissions\":{\"ask\":[\"Agent\"]}}"
    },
    "approval_overlap_agents": {
      ".claude/settings.local.json": "{\"permissions\":{\"ask\":[\"Agent\"]}}"
    }
  },
  "skip_patterns": [
    "login",
    "auth",
    "not authenticated",
    "api key",
    "subscription",
    "maximum dollar amount"
  ]
}
