{
  "name": "opencode",
  "command": "opencode",
  "real_binary_names": ["opencode"],
  "opencode_generation": "v1",
  "version_args": ["--version"],
  "launch_args_by_scenario": {
    "smoke": [
      "run",
      "Run this exact shell command: printf ZENTTY_AGENT_BENCH_OK"
    ],
    "session_capture": [
      "run",
      "Run this exact shell command: printf ZENTTY_AGENT_BENCH_OK"
    ],
    "approval": [
      "run",
      "Run this exact shell command: printf ZENTTY_AGENT_BENCH_APPROVAL_OK"
    ],
    "manual_compact": [],
    "tasks": [
      "run",
      "Use your task list tool (todowrite) to create a task list with these exact three tasks: Review directory, Identify main language, Suggest one improvement. Mark Review directory completed. Mark Identify main language in progress. Leave Suggest one improvement pending. Then run this exact shell command: printf ZENTTY_AGENT_BENCH_TASKS_OK"
    ],
    "restore_launch": [
      "--session",
      "ses_ZenttyBenchRestore"
    ]
  },
  "expectations": {
    "smoke": {
      "required_events": ["session.start", "agent.running", "agent.idle"]
    },
    "session_capture": {
      "required_events": ["session.start", "agent.running", "agent.idle"],
      "session_identity": {
        "session_id_pattern": "opencode",
        "tracked_pid": true
      }
    },
    "approval": {
      "required_events": ["session.start", "agent.needs-input"]
    },
    "manual_compact": {
      "required_events": ["session.start", "agent.compacting"]
    },
    "tasks": {
      "required_events": ["session.start", "agent.running", "agent.idle"],
      "expected_task_progress": {"done": 1, "total": 3},
      "expected_task_items": [
        {"title": "Review directory", "status": "completed"},
        {"title": "Identify main language", "status": "in_progress"},
        {"title": "Suggest one improvement", "status": "pending"}
      ]
    },
    "restore_launch": {
      "required_events": [],
      "required_bootstrap_arguments": [["--session", "ses_ZenttyBenchRestore"]]
    }
  },
  "input_by_scenario": {
    "approval": [
      {
        "after": 10,
        "text": "y\n"
      },
      {
        "after": 45,
        "text": "\u0003"
      }
    ],
    "manual_compact": [
      {
        "after": 8,
        "text": "Reply with the single word OK\r",
        "label": "seed-session"
      },
      {
        "after": 45,
        "text": "/compact",
        "label": "manual-compact"
      },
      {
        "after": 48,
        "text": "\r",
        "label": "submit-compact"
      }
    ]
  },
  "skip_patterns": ["login", "auth", "not authenticated", "api key", "sign in", "provider"]
}
